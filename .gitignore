# ==========================================
# 1. 后端 (FastAPI / Python) 忽略规则
# ==========================================
backend/.venv/
backend/models/
backend/runtime_dlls/
backend/static/

# 忽略所有 Python 离线安装包（whl 文件）
**/*.whl

# 针对 backend/test 的特殊规则：忽略所有 .mp4 文件
backend/test/**/*.mp4
backend/test/*.mp4

# 通用的 Python 缓存
**/__pycache__/
**/*.py[cod]

# ==========================================
# 2. 前端 (Vue3 + TS + Vite) 忽略规则
# ==========================================
frontend/front/node_modules/

# 【注意】如果你想保留 dist 文件夹，就不要写 frontend/front/dist/
# 如果以后想通了不想传了，再把下面这行前面的 # 删掉：
# frontend/front/dist/

# 忽略本地开发环境配置
frontend/front/.env*.local

# ==========================================
# 3. 通用系统与编辑器文件
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/